# Template for local development. Copy it to `.streamlit/secrets.toml`
# (which is gitignored) and fill in the values. On Streamlit Community Cloud,
# paste these same keys into the app's Secrets editor instead; no file is
# committed.

# Free football-data.org token, required by the first-run data load.
# Register at https://www.football-data.org/client/register
FOOTBALL_DATA_ORG_API_KEY = "replace-with-your-token"

# Marks this deployment as publicly reachable. It enables the licence guard and
# the first-run bootstrap. Leave it unset in a local checkout, which keeps using
# whatever is already in data/.
PREDICT_FOOTBALL_PUBLIC_DEPLOY = "1"

# Allow the app to reach the network so it can download its data on first run.
# Without this the bootstrap cannot fetch and will say so.
PREDICT_FOOTBALL_ALLOW_NETWORK = "1"
