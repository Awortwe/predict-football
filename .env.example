# ---------------------------------------------------------------------------
# predict_football -- local environment template
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
#   PowerShell:  Copy-Item .env.example .env
#
# NOTE: the project runs fully WITHOUT any of these keys set. Free cached
# historical data needs no credentials at all. The keys below are only needed
# for the optional live providers used by `predict-football poll`.
# ---------------------------------------------------------------------------

# --- Live data providers (optional) ----------------------------------------
# Needed only for `predict-football poll`; the historical sources need no keys.
# Both free tiers are far too limited for real use; see docs/DATA_SOURCES.md.
# Free tier: 10 calls/minute, DELAYED scores, no live, no lineups, no odds.
FOOTBALL_DATA_ORG_API_KEY=

# Free tier: 100 requests/day. Enough for a small daily poller, nothing more.
API_FOOTBALL_KEY=

# --- StatsBomb open data (optional) ---------------------------------------
# The open-data repo is public and needs no token. Registration is only
# requested by their terms; see docs/DATA_SOURCES.md before shipping anything
# derived from it publicly (licence forbids redistribution and requires the
# StatsBomb logo on published analysis).
STATSBOMB_EMAIL=

# --- Optional LLM narrative polish (optional, phase 6+) -------------------
# The narrative layer is fully rule-based and works with no key at all.
# Set an LLM_PROVIDER to optionally polish generated text. Nothing in the
# system depends on this.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- Environment tuning ----------------------------------------------------
# Network access is OPT-IN. Leave unset (or 0) for offline runs; set to 1 to hit
# providers over the network. Every write path that needs the network checks it.
PREDICT_FOOTBALL_ALLOW_NETWORK=1

# How many days a cached download stays fresh. The `poll` command overrides this
# with --max-age-days (default 0) so a daily poll actually re-downloads.
PREDICT_FOOTBALL_CACHE_TTL_DAYS=7

PREDICT_FOOTBALL_LOG_LEVEL=INFO
